#!/bin/sh

### BEGIN INIT INFO
# Provides:          x-ui
# Required-Start:    $network
# Required-Stop:     $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: x-ui service
### END INIT INFO

DAEMON=/usr/local/x-ui/x-ui
DAEMON_NAME=x-ui
PIDFILE=/run/${DAEMON_NAME}.pid
WORKDIR=/usr/local/x-ui
export XRAY_VMESS_AEAD_FORCED="${XRAY_VMESS_AEAD_FORCED:-false}"

if [ ! -x "${DAEMON}" ]; then
    echo "${DAEMON} 不存在或不可执行" >&2
    exit 5
fi

start_service() {
    if [ -f "${PIDFILE}" ] && kill -0 "$(cat "${PIDFILE}")" 2>/dev/null; then
        return 0
    fi
    rm -f "${PIDFILE}"
    start-stop-daemon --start --background --make-pidfile \
        --pidfile "${PIDFILE}" --chdir "${WORKDIR}" --exec "${DAEMON}"
}

stop_service() {
    if [ ! -f "${PIDFILE}" ]; then
        return 0
    fi
    start-stop-daemon --stop --retry=TERM/30/KILL/5 --pidfile "${PIDFILE}" --exec "${DAEMON}"
    status=$?
    rm -f "${PIDFILE}"
    return "${status}"
}

case "$1" in
    start)
        start_service
        ;;
    stop)
        stop_service
        ;;
    restart|force-reload)
        stop_service
        start_service
        ;;
    reload)
        if [ -f "${PIDFILE}" ]; then
            kill -USR1 "$(cat "${PIDFILE}")"
        fi
        ;;
    status)
        if [ -f "${PIDFILE}" ] && kill -0 "$(cat "${PIDFILE}")" 2>/dev/null; then
            echo "x-ui is running"
            exit 0
        fi
        echo "x-ui is not running"
        exit 3
        ;;
    *)
        echo "用法: $0 {start|stop|restart|reload|status}"
        exit 2
        ;;
esac
